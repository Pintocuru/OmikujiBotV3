"isCountEvent":true,"countEvent":1,"log":{"targetKey":"","logFormat":"<<user>> <<score>> <<createdAt>>","logLimit":5}},"weight":1,"isPriority":false,"criteria":null},{"id":"55ee8a10-f88c-4dfd-823f-7dbaca47fe79","key":"55ee8a10-f88c-4dfd-823f-7dbaca47fe79","name":"失敗","description":"","createdAt":"2026-02-27T03:58:41.707Z","updatedAt":"2026-02-27T03:58:41.707Z","order":0,"isEnabled":true,"daisyColor":"primary","tags":[],"accessLevel":"basic","type":"postActions","postActions":[{"delaySeconds":0,"actionType":"wordParty","wordParty":"DoorDashFailed"},{"delaySeconds":1.5,"actionType":"message","characterKey":null,"iconKey":"default","sound":"","message":{"bubble":"{{\n  // 【状態の初期化】\n  // 直前の試行が「成功」だった場合は、分母を初期値の 1 にリセット。\n  // そうでなければ、現在の累積されている「失敗値」をベースに計算を開始します。\n  val = bool(door_suc<<userId>>) ? 1 : door_fail<<userId>>;\n  suc = door_f_count<<userId>>;\n\n  // 【連続記録の更新】\n  // すでに「失敗」の状態が継続している場合、現在の分母を 2倍 に増幅。\n  // 初めての失敗、またはリセット直後なら 2 に設定し、累積失敗カウントを +1 します。\n  val = bool(door_fail<<userId>>) ? val * 2 : 2;\n  suc = suc + 1;\n  door_fall_total = door_fall_total + 1;\n\n  // 【データの永続化】\n  // 算出された分母と累積カウントを保存。\n  // 失敗の状態を更新するため、対となる「成功フラグ」は 0 で上書きします。\n  door_fail<<userId>> = val;\n  door_f_count<<userId>> = suc;\n  door_suc<<userId>> = 0;\n\n  // 【UI表示用データ】\n  // 現在の確率（1/x形式）と、これまでの◯×履歴を視覚化\n  text = str('1/', val);\n  symbol = str('◯', door_s_count<<userId>> , ' ×' , door_f_count<<userId>> );\n  \n  // 表示スタイルは標準（neutral）に設定\n  variant = 'neutral';\n  unique = 'true';\n}}","isToast":false}}],"gameScripts":{"delaySeconds":0,"scriptId":null,"queryString":"","characterKey":null},"special":"return","behavior":{"type":"return","isCountEvent":true,"countEvent":1,"log":{"targetKey":"","logFormat":"<<user>> <<score>> <<createdAt>>","logLimit":5}},"weight":1,"isPriority":false,"criteria":null}],"ruleType":"comments","trigger":{"conditions":["comment"],"userName":[],"access":[],"gift":[],"comment":["ドア"]},"limits":{"cooldownSeconds":3,"cooldownMessage":null,"isRepeatAllowed"