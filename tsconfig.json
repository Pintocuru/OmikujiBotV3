{
  "ts-node": {
    "esm": true,
    "experimentalSpecifierResolution": "node"
  },
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "noEmitOnError": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "jsx": "preserve",
    "paths": {
      "@/*": ["./src/*"],
      "@assets/*": ["./assets/*"],
      "@packages/*": ["./packages/*"],
      "@server/*": ["./server/*"],
      "@tools/*": ["./tools/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts",
    "src/**/*.vue",
    "packages/**/*.ts",
    "packages/**/*.d.ts",
    "packages/**/*.vue",
    "server/**/*.ts",
    "tools/**/*.ts",
    "build/**/*.ts",
    "*.ts"
  ],
  "exclude": ["node_modules", "archives", "**/*.test.ts"]
}
