{
  "ts-node": {
    "esm": true,
    "experimentalSpecifierResolution": "node"
  },
  "compilerOptions": {
    "noEmit": false,
    "resolveJsonModule": true,
    "noEmitOnError": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": [
      "node"
    ],
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "jsx": "preserve",
    "paths": {
      "@shared/*": [
        "../../shared/*"
      ],
      "@assets/*": [
        "./assets/*"
      ],
      "@/*": [
        "./src/*"
      ],
      "@main/*": [
        "./src/generator/*"
      ],
      "@config/*": [
        "./src/ConfigMaker/*"
      ],
      "@game/*": [
        "./src/GameScripts/*"
      ],
      "@sounds/*": [
        "./src/common/sounds/*"
      ],
      "@migrations/*": [
        "./src/common/migrations/*"
      ],
      "@types/*": [
        "./src/types/*"
      ],
    }
  },
  "include": [
    "../../shared/**/*.ts",
    "../../shared/**/*.d.ts",
    "../../shared/**/*.vue",
    "src/**/*.ts",
    "src/**/*.d.ts",
    "src/**/*.vue",
    "server/**/*.ts",
    "tools/**/*.ts",
    "build/**/*.ts",
    "*.ts"
  ],
  "exclude": [
    "node_modules",
    "archives",
    "**/*.test.ts"
  ]
}